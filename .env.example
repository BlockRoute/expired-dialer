# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Public anon/publishable key. Never a service-role key.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is accepted as an alias.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_...) or legacy service-role key.
SUPABASE_SERVICE_ROLE_KEY=

# The single email allowed to sign in
ALLOWED_EMAIL=

# App
APP_URL=http://localhost:3000

# Twilio (Voice SDK calling)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
# Cell number inbound calls forward to, E.164 (later task)
DANIEL_CELL=

# Anthropic (coaching, summaries)
ANTHROPIC_API_KEY=

# Used by later tasks
# Deepgram live transcription
DEEPGRAM_API_KEY=
# TypeSafe (Jev) coaching classifier
TYPESAFE_API_KEY=
# RealtyAPI.io sold comps for CMAs
REALTYAPI_KEY=
