# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key only (sb_publishable_...) or legacy anon key. Never a service-role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...) or legacy service-role key.
SUPABASE_SERVICE_ROLE_KEY=

# The single email allowed to sign in
ALLOWED_EMAIL=

# App
APP_URL=http://localhost:3000

# Twilio (Voice SDK calling)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=

# Anthropic (coaching, summaries)
ANTHROPIC_API_KEY=
